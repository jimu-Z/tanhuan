<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.conversation.mapper.MajorMapper">

    <resultMap type="Major" id="MajorResult">
        <id     property="majorId"    column="major_id"    />
        <result property="majorName"  column="major_name"  />
        <result property="majorCode"  column="major_code"  />
        <result property="deptId"     column="dept_id"     />
        <result property="status"     column="status"      />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectMajorVo">
        select major_id, major_name, major_code, dept_id, status, create_by, create_time, update_by, update_time, remark
        from biz_major
    </sql>

    <select id="selectMajorList" parameterType="Major" resultMap="MajorResult">
        <include refid="selectMajorVo"/>
        <where>
            <if test="majorName != null and majorName != ''">
                AND major_name like concat('%', #{majorName}, '%')
            </if>
            <if test="majorCode != null and majorCode != ''">
                AND major_code = #{majorCode}
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            ${params.dataScope}
        </where>
    </select>

    <select id="selectMajorById" parameterType="Long" resultMap="MajorResult">
        <include refid="selectMajorVo"/>
        where major_id = #{majorId}
    </select>

    <select id="selectMajorByDeptId" parameterType="Long" resultMap="MajorResult">
        <include refid="selectMajorVo"/>
        where dept_id = #{deptId}
    </select>

    <insert id="insertMajor" parameterType="Major" useGeneratedKeys="true" keyProperty="majorId">
        insert into biz_major(
            <if test="majorName != null and majorName != ''">major_name,</if>
            <if test="majorCode != null and majorCode != ''">major_code,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="majorName != null and majorName != ''">#{majorName},</if>
            <if test="majorCode != null and majorCode != ''">#{majorCode},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateMajor" parameterType="Major">
        update biz_major
        <set>
            <if test="majorName != null and majorName != ''">major_name = #{majorName},</if>
            <if test="majorCode != null and majorCode != ''">major_code = #{majorCode},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where major_id = #{majorId}
    </update>

    <delete id="deleteMajorById" parameterType="Long">
        delete from biz_major where major_id = #{majorId}
    </delete>

    <delete id="deleteMajorByIds" parameterType="Long">
        delete from biz_major where major_id in
        <foreach collection="array" item="majorId" open="(" separator="," close=")">
            #{majorId}
        </foreach>
    </delete>

</mapper>