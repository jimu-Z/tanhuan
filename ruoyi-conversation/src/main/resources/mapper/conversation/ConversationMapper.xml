<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.conversation.mapper.ConversationMapper">

    <resultMap type="Conversation" id="ConversationResult">
        <id     property="conversationId"    column="conversation_id"    />
        <result property="studentNo"         column="student_no"         />
        <result property="studentName"       column="student_name"       />
        <result property="collegeName"       column="college_name"       />
        <result property="majorName"         column="major_name"         />
        <result property="className"         column="class_name"         />
        <result property="deptId"            column="dept_id"            />
        <result property="conversationTime"  column="conversation_time"  />
        <result property="conversationPlace" column="conversation_place" />
        <result property="speaker"           column="speaker"            />
        <result property="topic"             column="topic"              />
        <result property="content"           column="content"            />
        <result property="followUpItems"     column="follow_up_items"    />
        <result property="status"            column="status"             />
        <result property="delFlag"           column="del_flag"           />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>

    <sql id="selectConversationVo">
        select conversation_id, student_no, student_name, college_name, major_name, class_name,
               dept_id, conversation_time, conversation_place, speaker, topic, content,
               follow_up_items, status, del_flag, create_by, create_time, update_by, update_time, remark
        from biz_conversation
    </sql>

    <select id="selectConversationList" parameterType="Conversation" resultMap="ConversationResult">
        <include refid="selectConversationVo"/>
        <where>
            <if test="studentNo != null and studentNo != ''">
                AND student_no like concat('%', #{studentNo}, '%')
            </if>
            <if test="studentName != null and studentName != ''">
                AND student_name like concat('%', #{studentName}, '%')
            </if>
            <if test="collegeName != null and collegeName != ''">
                AND college_name like concat('%', #{collegeName}, '%')
            </if>
            <if test="majorName != null and majorName != ''">
                AND major_name like concat('%', #{majorName}, '%')
            </if>
            <if test="className != null and className != ''">
                AND class_name like concat('%', #{className}, '%')
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
            <if test="speaker != null and speaker != ''">
                AND speaker like concat('%', #{speaker}, '%')
            </if>
            <if test="topic != null and topic != ''">
                AND topic like concat('%', #{topic}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND conversation_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND conversation_time &lt;= #{params.endTime}
            </if>
            ${params.dataScope}
        </where>
    </select>

    <select id="selectConversationById" parameterType="Long" resultMap="ConversationResult">
        <include refid="selectConversationVo"/>
        where conversation_id = #{conversationId}
    </select>

    <select id="selectConversationByStudentNo" parameterType="String" resultMap="ConversationResult">
        <include refid="selectConversationVo"/>
        where student_no = #{studentNo}
        order by conversation_time desc
    </select>

    <select id="selectConversationTimeLine" parameterType="String" resultMap="ConversationResult">
        <include refid="selectConversationVo"/>
        where student_no = #{studentNo} and del_flag = '0'
        order by conversation_time desc
    </select>

    <insert id="insertConversation" parameterType="Conversation" useGeneratedKeys="true" keyProperty="conversationId">
        insert into biz_conversation(
            <if test="studentNo != null and studentNo != ''">student_no,</if>
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="collegeName != null and collegeName != ''">college_name,</if>
            <if test="majorName != null and majorName != ''">major_name,</if>
            <if test="className != null and className != ''">class_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="conversationTime != null">conversation_time,</if>
            <if test="conversationPlace != null and conversationPlace != ''">conversation_place,</if>
            <if test="speaker != null and speaker != ''">speaker,</if>
            <if test="topic != null and topic != ''">topic,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="followUpItems != null and followUpItems != ''">follow_up_items,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="studentNo != null and studentNo != ''">#{studentNo},</if>
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="collegeName != null and collegeName != ''">#{collegeName},</if>
            <if test="majorName != null and majorName != ''">#{majorName},</if>
            <if test="className != null and className != ''">#{className},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="conversationTime != null">#{conversationTime},</if>
            <if test="conversationPlace != null and conversationPlace != ''">#{conversationPlace},</if>
            <if test="speaker != null and speaker != ''">#{speaker},</if>
            <if test="topic != null and topic != ''">#{topic},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="followUpItems != null and followUpItems != ''">#{followUpItems},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateConversation" parameterType="Conversation">
        update biz_conversation
        <set>
            <if test="studentNo != null and studentNo != ''">student_no = #{studentNo},</if>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="collegeName != null">college_name = #{collegeName},</if>
            <if test="majorName != null">major_name = #{majorName},</if>
            <if test="className != null">class_name = #{className},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="conversationTime != null">conversation_time = #{conversationTime},</if>
            <if test="conversationPlace != null">conversation_place = #{conversationPlace},</if>
            <if test="speaker != null">speaker = #{speaker},</if>
            <if test="topic != null">topic = #{topic},</if>
            <if test="content != null">content = #{content},</if>
            <if test="followUpItems != null">follow_up_items = #{followUpItems},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where conversation_id = #{conversationId}
    </update>

    <delete id="deleteConversationById" parameterType="Long">
        delete from biz_conversation where conversation_id = #{conversationId}
    </delete>

    <delete id="deleteConversationByIds" parameterType="Long">
        delete from biz_conversation where conversation_id in
        <foreach collection="array" item="conversationId" open="(" separator="," close=")">
            #{conversationId}
        </foreach>
    </delete>

    <select id="countPendingConversations" resultType="Long">
        select count(1) from biz_conversation where status != '0' and del_flag = '0'
    </select>

    <select id="countThisMonthConversations" resultType="Long">
        select count(1) from biz_conversation
        where date_format(conversation_time, '%Y%m') = date_format(curdate(), '%Y%m')
        and del_flag = '0'
    </select>

    <select id="countCompletedConversations" resultType="Long">
        select count(1) from biz_conversation where status = '0' and del_flag = '0'
    </select>

    <select id="selectRecentConversations" resultMap="ConversationResult">
        <include refid="selectConversationVo"/>
        where del_flag = '0'
        order by create_time desc
        limit 10
    </select>

    <select id="selectPendingConversations" resultMap="ConversationResult">
        <include refid="selectConversationVo"/>
        where status != '0' and del_flag = '0'
        order by create_time desc
        limit 10
    </select>

</mapper>