{"remainingRequest":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\src\\views\\talks\\index.vue?vue&type=script&lang=js","dependencies":[{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\src\\views\\talks\\index.vue","mtime":1780327076249},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1780328458263},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\index.js","mtime":1780328461293}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0CA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/views/talks","sourcesContent":["<template>\n  <div class=\"talks-page\">\n    <h3 class=\"page-title\">我的谈话记录</h3>\n    <el-table v-loading=\"loading\" :data=\"tableData\" border stripe style=\"width: 100%;\">\n      <el-table-column type=\"index\" label=\"序号\" width=\"60\" align=\"center\" />\n      <el-table-column prop=\"createTime\" label=\"谈话时间\" width=\"180\" align=\"center\" />\n      <el-table-column prop=\"studentName\" label=\"谈话人\" width=\"120\" align=\"center\" />\n      <el-table-column prop=\"followupStatus\" label=\"谈话类型\" width=\"120\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-tag v-if=\"scope.row.followupStatus === '1'\" type=\"warning\">首次谈话</el-tag>\n          <el-tag v-else-if=\"scope.row.followupStatus === '2'\" type=\"success\">跟进谈话</el-tag>\n          <el-tag v-else-if=\"scope.row.followupStatus === '0'\" type=\"danger\">紧急谈话</el-tag>\n          <span v-else>-</span>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"followupPlan\" label=\"谈话内容\" min-width=\"200\" show-overflow-tooltip />\n      <el-table-column label=\"内容标签\" width=\"100\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-tag size=\"small\" type=\"info\">{{ scope.row.followupStatus || '-' }}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"反馈状态\" width=\"120\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-tag v-if=\"scope.row.studentFeedback === '无' || !scope.row.studentFeedback\" type=\"info\">未反馈</el-tag>\n          <el-tag v-else type=\"success\">已反馈</el-tag>\n        </template>\n      </el-table-column>\n    </el-table>\n    <el-pagination\n      v-if=\"total > 0\"\n      style=\"margin-top: 20px; text-align: right;\"\n      background\n      layout=\"total, prev, pager, next\"\n      :total=\"total\"\n      :page-size=\"queryParams.pageSize\"\n      :current-page.sync=\"queryParams.pageNum\"\n      @current-change=\"fetchList\"\n    />\n  </div>\n</template>\n\n<script>\nimport { getMyRecords } from '@/api/talk/studentApi'\n\nexport default {\n  name: 'TalksList',\n  data() {\n    return {\n      loading: false,\n      tableData: [],\n      total: 0,\n      queryParams: {\n        pageNum: 1,\n        pageSize: 10\n      }\n    }\n  },\n  created() {\n    this.fetchList()\n  },\n  methods: {\n    fetchList() {\n      this.loading = true\n      const params = {\n        ...this.queryParams\n      }\n      getMyRecords(params).then(res => {\n        this.tableData = res.rows || []\n        this.total = res.total || 0\n        this.loading = false\n      }).catch(() => {\n        this.loading = false\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.talks-page {\n  padding: 10px;\n}\n\n.page-title {\n  font-size: 20px;\n  color: #303133;\n  margin-bottom: 20px;\n}\n</style>\n"]}]}