{"remainingRequest":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\src\\views\\pending\\index.vue?vue&type=style&index=0&id=5b63f5b0&scoped=true&lang=css","dependencies":[{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\src\\views\\pending\\index.vue","mtime":1780327068756},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\css-loader\\dist\\cjs.js","mtime":1780328459254},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1780328462103},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\postcss-loader\\src\\index.js","mtime":1780328460278},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1780328458263},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\index.js","mtime":1780328461293}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+HA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/views/pending","sourcesContent":["<template>\n  <div class=\"pending-page\">\n    <h3 class=\"page-title\">待处理谈话</h3>\n    <el-table v-loading=\"loading\" :data=\"tableData\" border stripe style=\"width: 100%;\">\n      <el-table-column type=\"index\" label=\"序号\" width=\"60\" align=\"center\" />\n      <el-table-column prop=\"createTime\" label=\"谈话时间\" width=\"180\" align=\"center\" />\n      <el-table-column prop=\"studentName\" label=\"谈话人\" width=\"120\" align=\"center\" />\n      <el-table-column prop=\"followupPlan\" label=\"谈话内容\" min-width=\"250\" show-overflow-tooltip />\n      <el-table-column label=\"反馈状态\" width=\"120\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-tag v-if=\"scope.row.studentFeedback === '无' || !scope.row.studentFeedback\" type=\"danger\">待反馈</el-tag>\n          <el-tag v-else type=\"success\">已反馈</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" width=\"120\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-button v-if=\"scope.row.studentFeedback === '无' || !scope.row.studentFeedback\"\n            type=\"primary\" size=\"small\" @click=\"openFeedback(scope.row)\">\n            填写反馈\n          </el-button>\n          <span v-else style=\"color: #67C23A;\">已完成</span>\n        </template>\n      </el-table-column>\n    </el-table>\n    <el-pagination\n      v-if=\"total > 0\"\n      style=\"margin-top: 20px; text-align: right;\"\n      background\n      layout=\"total, prev, pager, next\"\n      :total=\"total\"\n      :page-size=\"queryParams.pageSize\"\n      :current-page.sync=\"queryParams.pageNum\"\n      @current-change=\"fetchList\"\n    />\n\n    <el-dialog title=\"填写反馈\" :visible.sync=\"dialogVisible\" width=\"500px\" :close-on-click-modal=\"false\">\n      <el-form ref=\"feedbackForm\" :model=\"feedbackForm\" :rules=\"feedbackRules\" label-width=\"100px\">\n        <el-form-item label=\"反馈内容\" prop=\"studentFeedback\">\n          <el-input v-model=\"feedbackForm.studentFeedback\" type=\"textarea\" :rows=\"5\"\n            placeholder=\"请输入您的反馈意见\" />\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取 消</el-button>\n        <el-button type=\"primary\" :loading=\"submitLoading\" @click=\"submitFeedback\">提 交</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { getPendingTalks, submitFeedback } from '@/api/talk/studentApi'\n\nexport default {\n  name: 'PendingTalks',\n  data() {\n    return {\n      loading: false,\n      submitLoading: false,\n      dialogVisible: false,\n      tableData: [],\n      total: 0,\n      queryParams: {\n        pageNum: 1,\n        pageSize: 10\n      },\n      feedbackForm: {\n        recordId: null,\n        studentFeedback: ''\n      },\n      feedbackRules: {\n        studentFeedback: [{ required: true, message: '请输入反馈内容', trigger: 'blur' }]\n      }\n    }\n  },\n  created() {\n    this.fetchList()\n  },\n  methods: {\n    fetchList() {\n      this.loading = true\n      const params = {\n        ...this.queryParams,\n        studentFeedback: '无',\n        notified: 1\n      }\n      getPendingTalks(params).then(res => {\n        this.tableData = res.rows || []\n        this.total = res.total || 0\n        this.loading = false\n      }).catch(() => {\n        this.loading = false\n      })\n    },\n    openFeedback(row) {\n      this.feedbackForm = {\n        recordId: row.recordId,\n        studentFeedback: ''\n      }\n      this.dialogVisible = true\n      this.$nextTick(() => {\n        this.$refs.feedbackForm && this.$refs.feedbackForm.clearValidate()\n      })\n    },\n    submitFeedback() {\n      this.$refs.feedbackForm.validate(valid => {\n        if (valid) {\n          this.submitLoading = true\n          submitFeedback({\n            recordId: this.feedbackForm.recordId,\n            studentFeedback: this.feedbackForm.studentFeedback\n          }).then(() => {\n            this.$message.success('反馈提交成功')\n            this.dialogVisible = false\n            this.submitLoading = false\n            this.fetchList()\n          }).catch(() => {\n            this.submitLoading = false\n          })\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.pending-page {\n  padding: 10px;\n}\n\n.page-title {\n  font-size: 20px;\n  color: #303133;\n  margin-bottom: 20px;\n}\n</style>\n"]}]}