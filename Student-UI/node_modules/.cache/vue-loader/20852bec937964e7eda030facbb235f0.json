{"remainingRequest":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\src\\App.vue?vue&type=script&lang=js","dependencies":[{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\src\\App.vue","mtime":1780326911415},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1780328458263},{"path":"F:\\kaifa\\XueXiaoTanHuan\\Student-UI\\node_modules\\vue-loader\\lib\\index.js","mtime":1780328461293}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["App.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmCA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"App.vue","sourceRoot":"src","sourcesContent":["<template>\n  <div id=\"app\">\n    <el-container v-if=\"$route.path !== '/login'\">\n      <el-header class=\"student-header\">\n        <div class=\"header-left\">\n          <h2>学生谈心谈话系统</h2>\n        </div>\n        <div class=\"header-right\">\n          <el-badge :value=\"pendingCount\" :hidden=\"pendingCount === 0\" class=\"header-badge\">\n            <i class=\"el-icon-bell\" style=\"font-size: 22px; cursor: pointer;\" @click=\"$router.push('/pending')\"></i>\n          </el-badge>\n          <el-dropdown @command=\"handleCommand\" class=\"user-dropdown\">\n            <span class=\"user-info\">\n              <i class=\"el-icon-user-solid\"></i>\n              {{ user.nickName || user.name || '学生' }}\n              <i class=\"el-icon-arrow-down\"></i>\n            </span>\n            <el-dropdown-menu slot=\"dropdown\">\n              <el-dropdown-item command=\"index\">首页</el-dropdown-item>\n              <el-dropdown-item command=\"talks\">我的谈话记录</el-dropdown-item>\n              <el-dropdown-item command=\"pending\">待处理谈话</el-dropdown-item>\n              <el-dropdown-item divided command=\"logout\">退出登录</el-dropdown-item>\n            </el-dropdown-menu>\n          </el-dropdown>\n        </div>\n      </el-header>\n      <el-main>\n        <router-view />\n      </el-main>\n    </el-container>\n    <router-view v-else />\n  </div>\n</template>\n\n<script>\nimport { getPendingTalks } from '@/api/talk/studentApi'\n\nexport default {\n  name: 'App',\n  data() {\n    return {\n      pendingCount: 0\n    }\n  },\n  computed: {\n    user() {\n      return this.$store.state.user\n    }\n  },\n  watch: {\n    '$store.state.token': {\n      handler(val) {\n        if (val) {\n          this.fetchPendingCount()\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    fetchPendingCount() {\n      getPendingTalks({ studentFeedback: '无', notified: 1, pageNum: 1, pageSize: 1 }).then(res => {\n        this.pendingCount = res.total || 0\n      }).catch(() => {})\n    },\n    handleCommand(command) {\n      if (command === 'logout') {\n        this.$store.dispatch('logout').then(() => {\n          this.$router.push('/login')\n        })\n      } else {\n        this.$router.push('/' + command)\n      }\n    }\n  }\n}\n</script>\n\n<style>\nhtml, body, #app {\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  font-family: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, sans-serif;\n}\n\n.student-header {\n  background-color: #409EFF;\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 20px;\n  height: 60px !important;\n  line-height: 60px;\n}\n\n.header-left h2 {\n  margin: 0;\n  font-size: 20px;\n  color: #fff;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 24px;\n}\n\n.header-badge {\n  margin-right: 10px;\n}\n\n.header-badge .el-icon-bell {\n  color: #fff;\n}\n\n.user-dropdown {\n  cursor: pointer;\n}\n\n.user-info {\n  color: #fff;\n  font-size: 14px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.el-main {\n  background-color: #f0f2f5;\n  min-height: calc(100vh - 60px);\n  padding: 20px;\n}\n\n.el-container {\n  height: 100%;\n}\n</style>\n"]}]}