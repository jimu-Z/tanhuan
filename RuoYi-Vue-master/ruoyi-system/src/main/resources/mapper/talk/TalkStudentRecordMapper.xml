<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.talk.mapper.TalkStudentRecordMapper">
    
    <resultMap type="TalkStudentRecord" id="TalkStudentRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="sessionId"    column="session_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="studentName"    column="student_name"    />
        <result property="studentCode"    column="student_code"    />
        <result property="studentFeedback"    column="student_feedback"    />
        <result property="originalStudentFeedback" column="original_student_feedback" />
        <result property="followupPlan"    column="followup_plan"    />
        <result property="followupStatus"    column="followup_status"    />
        <result property="notified"         column="notified"          />
        <result property="teacherNotified"  column="teacher_notified"  />
        <result property="talkType"    column="talk_type"    />
        <result property="talkTime"    column="talk_time"    />
        <result property="talkLocation"    column="talk_location"    />
        <result property="talkContent"    column="talk_content"    />
        <result property="talkPerson"    column="talk_person"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTalkStudentRecordVo">
        select tsr.record_id, tsr.session_id, tsr.student_id, st.student_name, st.student_code,
               tsr.student_feedback, tsr.original_student_feedback, tsr.followup_plan, tsr.followup_status,
               tsr.notified, tsr.teacher_notified,
               ts.talk_time, ts.talk_type, ts.talk_location, ts.talk_content, ts.talk_person,
               tsr.create_time, tsr.update_time
        from talk_student_record tsr
        left join talk_student st on tsr.student_id = st.student_id
        left join talk_session ts on tsr.session_id = ts.session_id
    </sql>

    <select id="selectTalkStudentRecordList" parameterType="TalkStudentRecord" resultMap="TalkStudentRecordResult">
        <include refid="selectTalkStudentRecordVo"/>
        <where>  
            <if test="sessionId != null and sessionId != ''">
                <if test="sessionId.toString().indexOf(',') != -1">
                    and tsr.session_id in
                    <foreach item="id" collection="sessionId.toString().split(',')" open="(" separator="," close=")">#{id}</foreach>
                </if>
                <if test="sessionId.toString().indexOf(',') == -1"> and tsr.session_id = #{sessionId}</if>
            </if>
            <if test="studentId != null "> and tsr.student_id = #{studentId}</if>
            <if test="studentCode != null and studentCode != ''"> and st.student_code = #{studentCode}</if>
            <if test="studentName != null and studentName != ''"> and st.student_name like concat('%', #{studentName}, '%')</if>
            <if test="studentFeedback != null and studentFeedback != ''"> and tsr.student_feedback = #{studentFeedback}</if>
            <if test="hasNoFeedback != null"> and (tsr.student_feedback is null or tsr.student_feedback = '' or tsr.student_feedback = '无')</if>
            <if test="followupPlan != null  and followupPlan != ''"> and tsr.followup_plan = #{followupPlan}</if>
            <if test="followupStatus != null  and followupStatus != ''"> and tsr.followup_status = #{followupStatus}</if>
            <if test="notified != null"> and tsr.notified = #{notified}</if>
            <if test="teacherNotified != null"> and tsr.teacher_notified = #{teacherNotified}</if>
            <if test="params.counselorUsername != null and params.counselorUsername != ''"> and tsr.session_id in (select ts.session_id from talk_session ts where ts.create_by = #{params.counselorUsername})</if>
            <if test="params.secretaryDeptId != null"> and tsr.student_id in (select stu.student_id from talk_student stu join sys_dept d on stu.dept_id = d.dept_id where (d.dept_id = #{params.secretaryDeptId} or find_in_set(#{params.secretaryDeptId}, d.ancestors)))</if>
        </where>
    </select>
    
    <select id="selectTalkStudentRecordByRecordId" parameterType="Long" resultMap="TalkStudentRecordResult">
        <include refid="selectTalkStudentRecordVo"/>
        where tsr.record_id = #{recordId}
    </select>

    <select id="selectTalkStudentRecordBySessionId" parameterType="Long" resultMap="TalkStudentRecordResult">
        <include refid="selectTalkStudentRecordVo"/>
        where tsr.session_id = #{sessionId}
    </select>

    <select id="selectTalkStudentRecordByStudentId" parameterType="Long" resultMap="TalkStudentRecordResult">
        <include refid="selectTalkStudentRecordVo"/>
        where tsr.student_id = #{studentId}
    </select>

    <insert id="insertTalkStudentRecord" parameterType="TalkStudentRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into talk_student_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">session_id,</if>
            <if test="studentId != null">student_id,</if>
            <if test="studentFeedback != null">student_feedback,</if>
            <if test="originalStudentFeedback != null">original_student_feedback,</if>
            <if test="followupPlan != null and followupPlan != ''">followup_plan,</if>
            <if test="followupStatus != null">followup_status,</if>
            <if test="notified != null">notified,</if>
            <if test="teacherNotified != null">teacher_notified,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">#{sessionId},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="studentFeedback != null">#{studentFeedback},</if>
            <if test="originalStudentFeedback != null">#{originalStudentFeedback},</if>
            <if test="followupPlan != null and followupPlan != ''">#{followupPlan},</if>
            <if test="followupStatus != null">#{followupStatus},</if>
            <if test="notified != null">#{notified},</if>
            <if test="teacherNotified != null">#{teacherNotified},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTalkStudentRecord" parameterType="TalkStudentRecord">
        update talk_student_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="sessionId != null">session_id = #{sessionId},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="studentFeedback != null">student_feedback = #{studentFeedback},</if>
            <if test="originalStudentFeedback != null">original_student_feedback = #{originalStudentFeedback},</if>
            <if test="followupPlan != null and followupPlan != ''">followup_plan = #{followupPlan},</if>
            <if test="followupStatus != null">followup_status = #{followupStatus},</if>
            <if test="notified != null">notified = #{notified},</if>
            <if test="teacherNotified != null">teacher_notified = #{teacherNotified},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteTalkStudentRecordByRecordId" parameterType="Long">
        delete from talk_student_record where record_id = #{recordId}
    </delete>

    <delete id="deleteTalkStudentRecordByRecordIds" parameterType="String">
        delete from talk_student_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <delete id="deleteTalkStudentRecordBySessionId" parameterType="Long">
        delete from talk_student_record where session_id = #{sessionId}
    </delete>

    <delete id="deleteTalkStudentRecordByStudentId" parameterType="Long">
        delete from talk_student_record where student_id = #{studentId}
    </delete>

    <select id="countRecords" resultType="int">
        select count(*) from talk_student_record
    </select>

    <select id="countRecordsByFollowupStatus" resultType="java.util.HashMap">
        select followup_status as status, count(*) as cnt
        from talk_student_record group by followup_status
    </select>

    <select id="countRecordsBySessionId" parameterType="Long" resultType="int">
        select count(*) from talk_student_record where session_id = #{sessionId}
    </select>

    <select id="countRecordsFiltered" parameterType="map" resultType="int">
        select count(*) from talk_student_record tsr
        <where>
            <if test="counselorUsername != null and counselorUsername != ''"> and tsr.session_id in (select ts.session_id from talk_session ts where ts.create_by = #{counselorUsername})</if>
            <if test="secretaryDeptId != null"> and tsr.student_id in (select stu.student_id from talk_student stu join sys_dept d on stu.dept_id = d.dept_id where (d.dept_id = #{secretaryDeptId} or find_in_set(#{secretaryDeptId}, d.ancestors)))</if>
        </where>
    </select>

    <select id="countRecordsByFollowupStatusFiltered" parameterType="map" resultType="java.util.HashMap">
        select tsr.followup_status as status, count(*) as cnt
        from talk_student_record tsr
        <where>
            <if test="counselorUsername != null and counselorUsername != ''"> and tsr.session_id in (select ts.session_id from talk_session ts where ts.create_by = #{counselorUsername})</if>
            <if test="secretaryDeptId != null"> and tsr.student_id in (select stu.student_id from talk_student stu join sys_dept d on stu.dept_id = d.dept_id where (d.dept_id = #{secretaryDeptId} or find_in_set(#{secretaryDeptId}, d.ancestors)))</if>
        </where>
        group by tsr.followup_status
    </select>

    <select id="countPendingFeedback" parameterType="map" resultType="int">
        select count(*) from talk_student_record tsr
        <where>
            tsr.student_feedback is not null and tsr.student_feedback != '' and tsr.student_feedback != '无'
            and tsr.teacher_notified = 0
            <if test="counselorUsername != null and counselorUsername != ''"> and tsr.session_id in (select ts.session_id from talk_session ts where ts.create_by = #{counselorUsername})</if>
            <if test="secretaryDeptId != null"> and tsr.student_id in (select stu.student_id from talk_student stu join sys_dept d on stu.dept_id = d.dept_id where (d.dept_id = #{secretaryDeptId} or find_in_set(#{secretaryDeptId}, d.ancestors)))</if>
        </where>
    </select>
</mapper>