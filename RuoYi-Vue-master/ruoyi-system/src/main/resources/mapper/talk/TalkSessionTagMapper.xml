<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.talk.mapper.TalkSessionTagMapper">

    <resultMap type="TalkSessionTag" id="TalkSessionTagResult">
        <result property="sessionId" column="session_id" />
        <result property="tagValue" column="tag_value" />
    </resultMap>

    <sql id="selectTalkSessionTagVo">
        select session_id, tag_value from talk_session_tag
    </sql>

    <insert id="insertTalkSessionTag">
        insert into talk_session_tag values(#{sessionId}, #{tagValue})
    </insert>

    <delete id="deleteTalkSessionTagBySessionId" parameterType="Long">
        delete from talk_session_tag where session_id = #{sessionId}
    </delete>

    <select id="selectTalkSessionTagBySessionId" parameterType="Long" resultMap="TalkSessionTagResult">
        <include refid="selectTalkSessionTagVo"/>
        where session_id = #{sessionId}
    </select>

    <select id="selectTagsBySessionIds" resultMap="TalkSessionTagResult">
        select session_id, tag_value
        from talk_session_tag
        where session_id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="countTagsByValue" resultType="java.util.HashMap">
        select tag_value as tag, count(*) as cnt
        from talk_session_tag group by tag_value
    </select>

    <select id="countTagsByValueFiltered" parameterType="map" resultType="java.util.HashMap">
        select tst.tag_value as tag, count(*) as cnt
        from talk_session_tag tst
        join talk_session ts on tst.session_id = ts.session_id
        <where>
            <if test="counselorUsername != null and counselorUsername != ''"> and ts.create_by = #{counselorUsername}</if>
            <if test="secretaryDeptId != null"> and ts.session_id in (select tsr.session_id from talk_student_record tsr join talk_student stu on tsr.student_id = stu.student_id join sys_dept d on stu.dept_id = d.dept_id where (d.dept_id = #{secretaryDeptId} or find_in_set(#{secretaryDeptId}, d.ancestors)))</if>
        </where>
        group by tst.tag_value
    </select>
</mapper>
