<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.talk.mapper.TalkAlertMapper">

    <resultMap type="TalkAlert" id="TalkAlertResult">
        <result property="alertId"       column="alert_id"       />
        <result property="studentId"     column="student_id"     />
        <result property="alertType"     column="alert_type"     />
        <result property="alertLevel"    column="alert_level"    />
        <result property="alertReason"   column="alert_reason"   />
        <result property="alertStatus"   column="alert_status"   />
        <result property="handler"       column="handler"        />
        <result property="handleTime"    column="handle_time"    />
        <result property="handleRemark"  column="handle_remark"  />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="studentName"   column="student_name"   />
        <result property="studentCode"   column="student_code"   />
    </resultMap>

    <sql id="selectTalkAlertVo">
        select a.alert_id, a.student_id, a.alert_type, a.alert_level, a.alert_reason,
               a.alert_status, a.handler, a.handle_time, a.handle_remark,
               a.create_by, a.create_time, a.update_by, a.update_time,
               s.student_name, s.student_code
        from talk_alert a
        left join talk_student s on a.student_id = s.student_id
    </sql>

    <select id="selectTalkAlertList" parameterType="TalkAlert" resultMap="TalkAlertResult">
        <include refid="selectTalkAlertVo"/>
        <where>
            <if test="studentId != null"> and a.student_id = #{studentId}</if>
            <if test="alertType != null and alertType != ''"> and a.alert_type = #{alertType}</if>
            <if test="alertLevel != null and alertLevel != ''"> and a.alert_level = #{alertLevel}</if>
            <if test="alertStatus != null and alertStatus != ''"> and a.alert_status = #{alertStatus}</if>
            <if test="params.counselorUsername != null and params.counselorUsername != ''"> and a.student_id in (select sr.student_id from talk_student_record sr join talk_session ts on sr.session_id = ts.session_id where ts.create_by = #{params.counselorUsername})</if>
            <if test="params.secretaryDeptId != null"> and s.dept_id is not null and exists (select 1 from sys_dept d where (d.dept_id = #{params.secretaryDeptId} or find_in_set(#{params.secretaryDeptId}, d.ancestors)) and d.dept_id = s.dept_id)</if>
        </where>
        order by a.create_time desc
    </select>

    <select id="selectTalkAlertById" parameterType="Long" resultMap="TalkAlertResult">
        <include refid="selectTalkAlertVo"/>
        where a.alert_id = #{alertId}
    </select>

    <insert id="insertTalkAlert" parameterType="TalkAlert" useGeneratedKeys="true" keyProperty="alertId">
        insert into talk_alert
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentId != null">student_id,</if>
            <if test="alertType != null and alertType != ''">alert_type,</if>
            <if test="alertLevel != null and alertLevel != ''">alert_level,</if>
            <if test="alertReason != null and alertReason != ''">alert_reason,</if>
            <if test="alertStatus != null and alertStatus != ''">alert_status,</if>
            <if test="handler != null and handler != ''">handler,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="handleRemark != null and handleRemark != ''">handle_remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentId != null">#{studentId},</if>
            <if test="alertType != null and alertType != ''">#{alertType},</if>
            <if test="alertLevel != null and alertLevel != ''">#{alertLevel},</if>
            <if test="alertReason != null and alertReason != ''">#{alertReason},</if>
            <if test="alertStatus != null and alertStatus != ''">#{alertStatus},</if>
            <if test="handler != null and handler != ''">#{handler},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="handleRemark != null and handleRemark != ''">#{handleRemark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateTalkAlert" parameterType="TalkAlert">
        update talk_alert
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="alertType != null and alertType != ''">alert_type = #{alertType},</if>
            <if test="alertLevel != null and alertLevel != ''">alert_level = #{alertLevel},</if>
            <if test="alertReason != null and alertReason != ''">alert_reason = #{alertReason},</if>
            <if test="alertStatus != null and alertStatus != ''">alert_status = #{alertStatus},</if>
            <if test="handler != null and handler != ''">handler = #{handler},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="handleRemark != null and handleRemark != ''">handle_remark = #{handleRemark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where alert_id = #{alertId}
    </update>

    <delete id="deleteTalkAlertByIds">
        delete from talk_alert where alert_id in
        <foreach collection="array" item="alertId" open="(" separator="," close=")">
            #{alertId}
        </foreach>
    </delete>

</mapper>
